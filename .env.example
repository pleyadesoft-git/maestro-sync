# Supabase (obligatorio) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # SOLO servidor (webhooks / Server Actions)
SUPABASE_SECRET_KEY=sb_secret_...        # O formato nuevo de clave secreta

# Super Administradores con acceso exclusivo al Panel de Administración
SUPER_ADMIN_BOOTSTRAP_EMAILS=admin@ejemplo.com,otro@ejemplo.com

# Base de datos (opcional, herramientas externas/migraciones)
DATABASE_URL=postgresql://postgres:password@db.TU-PROYECTO.supabase.co:5432/postgres

# Stripe (obligatorio para planes y webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
